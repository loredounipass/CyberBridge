# CyberBridge Server Environment Variables

# ─── Shared Encryption Key ──────────────────────────────────────────────────────
# MUST match the client's CYBERBRIDGE_KEY exactly
CYBERBRIDGE_KEY=CyberBridge_2024_SecureKey_Trading

# ─── Network ────────────────────────────────────────────────────────────────────
# IP address this server listens on (0.0.0.0 = all interfaces)
SERVER_BIND_HOST=0.0.0.0

# HTTP port for client communication (expose this via ngrok)
HTTP_PORT=18812

# Web UI port (internal, for Liquid Glass dashboard)
WEB_UI_PORT=18814

# ─── Timeouts ───────────────────────────────────────────────────────────────────
# Seconds before a client is considered IDLE (no poll received)
IDLE_TIMEOUT=20

# Seconds before a client is considered OFFLINE
OFFLINE_TIMEOUT=60

# Command timeout (seconds)
CMD_TIMEOUT=60

# ─── Flask ──────────────────────────────────────────────────────────────────────
# Secret key for Flask session signing
FLASK_SECRET_KEY=cyberbridge-web-secret-change-in-production

# ─── CORS ───────────────────────────────────────────────────────────────────────
# Allowed origins for Web UI and API (comma-separated)
# Use * for development, specific origins for production
# Locked to the ngrok domain used by clients
CORS_ORIGINS=https://marquis-prorefugee-lala.ngrok-free.app

# ─── UI ─────────────────────────────────────────────────────────────────────────
# Dashboard window title
WINDOW_TITLE=CyberBridge  v1.0  ▮  Remote Monitoring Station

# Camera refresh rate in milliseconds (~6 FPS at 150ms)
CAMERA_REFRESH_MS=150

# System info auto-refresh interval in seconds
SYSINFO_REFRESH_SEC=5